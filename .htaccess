# CI4 Student Portal – Root .htaccess
# Week 15 – Deployment: "Redirect all traffic to /public/"
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all requests to the /public/ folder
    # This hides application source files from the web root
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
